{
    "$schema": "https://json-schema.org/draft/2020-12/schema#",
    "type": "object",
    "title": "Nucleic Acid QC Schema",
    "description": "Reusable Protocol (ANY OF tool/software/workflow/pipeline/protocol) schema",
    "$defs": {
        "quality_metrics": {
            "type": "object",
            "properties": {
                "notes": {
                    "type": "string",
                    "help": "Notes about the quality metrics"
                },
                "yield_ng": {
                    "type": "number",
                    "minimum": 0,
                    "help": "Yield of nucleic acid in nanograms"
                },
                "qubit_ngul": {
                    "type": "number",
                    "minimum":0,
                    "help": "Nanogram per microliter"
                },
                "fragment_size_kb": {
                    "type": "number",
                    "minimum":0,
                    "help": "Fragment size in kilobases"
                },
                "spri_type": {
                    "type": "string",
                    "help": "Type of SPRI used"
                },
                "volume_ul": {
                    "type": "number",
                    "help": "Volume in microliters"
                }
            }
        }
    }
}
