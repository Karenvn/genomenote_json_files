{
    "$schema": "https://json-schema.org/draft/2020-12/schema#",
    "type": "object",
    "source": [
        "ToLPortal"
    ],
    "properties": {
        "methods": {
            "type": "object",
            "help": "Methods used to prepare a genomic library for sequencing. These are kept as separate subsections because they are populated from different workflow sources.",
            "properties": {
                "involved_persons": {
                    "type": "array",
                    "source": [
                        "AuthorsDB"
                    ],
                    "items": {
                        "$ref": "_author_schema.json#/$defs/author"
                    }
                },
                "prep_protocol": {
                    "type": "array",
                    "help": "Protocols used for the library preparation of the assembly set. Should be listed in the references.",
                    "items": {
                        "$ref": "_protocol_schema.json#/$defs/protocol"
                    }
                },
                "library_prep": {
                    "type": "array",
                    "help": "Details of library preparation methods/protocols.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "sample_role": {
                                "enum": [
                                    "pacbio",
                                    "hic",
                                    "ont",
                                    "rna",
                                    "isoseq",
                                    "chromium",
                                    "other"
                                ],
                                "help": "Role of this sample in the genome note workflow."
                            },
                            "library_preparation_and_sequencing": {
                                "type": "array",
                                "help": "Library preparation, sequencing platform and method metadata.",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "library_id": {
                                            "type": "string",
                                            "minLength": 1,
                                            "pattern": "\\S",
                                            "help": "Stable identifier for this library, unique within the genome note. Used by sequencing records to identify their source library; a display name is not automatically an identifier. Omit when the library identity is unknown."
                                        },
                                        "source_extraction_ids": {
                                            "type": "array",
                                            "minItems": 1,
                                            "uniqueItems": true,
                                            "items": {
                                                "type": "string",
                                                "minLength": 1,
                                                "pattern": "\\S",
                                                "help": "Identifier of a source extraction event recorded as extraction_id in the extraction methods."
                                            },
                                            "help": "Known extraction events used to prepare this library. Multiple identifiers represent pooled extraction inputs. Omit when the source extraction links are unknown; do not infer them from a shared sample accession or sample role."
                                        },
                                        "technology": {
                                            "enum": [
                                                "PacBio HiFi",
                                                "Hi-C",
                                                "RNA-seq",
                                                "Iso-Seq",
                                                "10x Chromium",
                                                "ONT",
                                                "Bionano",
                                                "Illumina",
                                                "other"
                                            ],
                                            "help": "Sequencing or data-generation technology."
                                        },
                                        "sample_accession": {
                                            "type": "string"
                                        },
                                        "experiment_accession": {
                                            "type": "string",
                                            "help": "One INSDC experiment accession associated with this library, for example ERX or SRX. A physical library may be used by several experiments; this scalar is not an exhaustive list. Record each archive run's experiment_accession with the sequencing data."
                                        },
                                        "library_name": {
                                            "type": "string"
                                        },
                                        "library_construction_protocol": {
                                            "type": "string",
                                            "help": "Give identifier of protocol detailed in references"
                                        },
                                        "library_construction_protocol_plaintext": {
                                            "type": "string",
                                            "help": "Short publication-ready plaintext-summary of the library construction protocol"
                                        }
                                    },
                                    "if": {
                                        "required": [
                                            "source_extraction_ids"
                                        ]
                                    },
                                    "then": {
                                        "required": [
                                            "library_id"
                                        ]
                                    }
                                }
                            }
                        },
                        "required": [
                            "sample_role"
                        ]
                    }
                }
            }
        }
    }
}
